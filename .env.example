# Template only, for running on your own computer. Create your real .env with:
#   python -m invoice_detector.cli init
# NEVER commit .env. In production, don't use a .env file: give each setting as an environment
# variable from a secrets manager, or as NAME_FILE=/path/to/file (see docs/DEPLOYMENT.md).
SECRET_KEY=
ENCRYPTION_KEYS=
INDEX_KEY=

# Local, single server: a SQLite file
DB_PATH=invoices.db

# Production: PostgreSQL with row-level security (overrides DB_PATH when set)
# DATABASE_URL=postgresql://invoice_app:APP_PASSWORD@db-host:5432/invoices
# Operator machine only (CLI: migrate, create-org). Never give this to the web server.
# DATABASE_ADMIN_URL=postgresql://owner:OWNER_PASSWORD@db-host:5432/invoices
# APP_DB_PASSWORD=APP_PASSWORD        # read by `migrate` to set the invoice_app password

# Optional: plain-English explanations, and AI reading of invoices the app can't read itself
# (AI reading also has to be switched on per company, in Settings)
ANTHROPIC_API_KEY=
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5-5
# DOC_ISOLATION=1                           # read uploaded documents in a separate process (keep on)
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Hosting ----
# PUBLIC_URL=https://invoices.example.com   # used in password-reset links and SSO redirects
# FORCE_HTTPS=1                             # redirect HTTP to HTTPS and send HSTS
# FORWARDED_ALLOW_IPS=127.0.0.1             # proxies whose X-Forwarded-* headers are trusted
# API_DOCS=0                                # hide the interactive API pages at /docs

# ---- Password-reset emails (optional) ----
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls                    # starttls | ssl | none
# SMTP_USER=invoices@example.com
# SMTP_PASSWORD=
# MAIL_FROM=Invoice Review <invoices@example.com>
# MAIL_DIR=outbox                           # testing: write emails as .eml files instead of sending

# ---- Single sign-on (optional; set any of these) ----
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=                      # your directory's ID, not "common"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_ISSUER=https://yourcompany.okta.com  # any other OpenID Connect provider
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Okta
