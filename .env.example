# Template only. Create your real .env with:  python -m invoice_detector.cli init
# NEVER commit .env.
SECRET_KEY=
ENCRYPTION_KEYS=
INDEX_KEY=

# Local, single server: a SQLite file
DB_PATH=invoices.db

# Production: PostgreSQL with row-level security (overrides DB_PATH when set)
# DATABASE_URL=postgresql://invoice_app:APP_PASSWORD@db-host:5432/invoices
# Operator machine only (CLI: migrate, create-org). Never give this to the web server.
# DATABASE_ADMIN_URL=postgresql://owner:OWNER_PASSWORD@db-host:5432/invoices
# APP_DB_PASSWORD=APP_PASSWORD        # read by `migrate` to set the invoice_app password

# Optional: enables plain-English explanations via the Anthropic API
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
