# Caddy gets and renews an HTTPS certificate automatically (Let's Encrypt) for DOMAIN, and
# redirects plain HTTP to HTTPS. With DOMAIN=localhost it uses its own local certificate.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	# One or several copies of the app (APP_REPLICAS). Caddy looks up every copy by name,
	# sends each request to the least busy one, and stops using a copy that fails until it
	# recovers. No sticky sessions are needed: the app keeps nothing in memory between
	# requests (sessions are signed cookies, rate limits and data are in PostgreSQL).
	reverse_proxy {
		dynamic a {
			name app
			port 8000
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 15s
	}
	header -Server
}
